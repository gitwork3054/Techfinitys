# Copy variables into your process manager / hosting provider.
# Never commit a live secret file or actual credentials.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-generated-secret
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
DJANGO_HTTPS_REDIRECT=true
DATABASE_URL=postgresql://dbuser:password@dbhost:5432/techfinitys_crm
DB_SSLMODE=require

# Google OIDC authentication: register a Google Cloud OAuth Web Application.
# Authorized redirect URI (match your production hostname exactly):
# https://techfinitys-crm-8wp1.onrender.com/auth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://techfinitys-crm-8wp1.onrender.com/auth/google/callback/
