# Copy variables into your process manager / hosting provider.
# Never commit a live secret file or actual credentials.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-generated-secret
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
DJANGO_HTTPS_REDIRECT=true
DATABASE_URL=postgresql://dbuser:password@dbhost:5432/techfinitys_crm
DB_SSLMODE=require
